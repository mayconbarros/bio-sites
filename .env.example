PORT=3000
NODE_ENV=development

# 1. Banco de Dados Neon (PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require

# 2. Upload de Imagens na Nuvem (Cloudinary - Recomendado)
# Você pode usar a URL completa OU as chaves separadas
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# 3. Alternativa: Vercel Blob (Opcional, se preferir em vez do Cloudinary)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

GEMINI_API_KEY=
